# Copy to .env and fill in. .env is git-ignored; never commit it.
# scripts/check-public.sh fails if any value marked private below appears in the repository.

# Google Cloud (private)
PROJECT_ID=your-gcp-project
REGION=us-east1
# ZONE defaults to ${REGION}-a
INSTANCE=your-cloud-sql-instance
VM_NAME=wetlab-vm
ADDRESS_NAME=wetlab-vm-ip

# Databases and logins (owner and app login names are private; every password is private)
PRODUCTION_DB=wetlab
DB_OWNER=lab_schema_owner
DB_OWNER_PASSWORD=
APP_DB_USER=wetlab_app
APP_PASSWORD=
POSTGRES_PASSWORD=

# Site (private)
SITE_HOST=wetlab.example.org
SITE_ALIASES=
# Signs the app's sign-in cookies; deploy/deploy_vm.sh fills it in when empty.
SESSION_SECRET=

# Check-only values, read by scripts/check-public.sh and nothing else (private)
STATIC_IP=
ACCOUNT_EMAIL=
